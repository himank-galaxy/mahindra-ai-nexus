# =============================================================================
# Mahindra AI Nexus — CONSOLIDATED environment template (root level)
#
# This file documents EVERY environment variable used by the project.
# It is a reference only — the application does NOT read this root file.
#
# Canonical per-component templates (already in the repo, do not overwrite):
#   backend/.env.example   -> copy to backend/.env
#   frontend/.env.example  -> copy to frontend/.env.local
#
# Never commit real .env files. Use placeholder values here.
# =============================================================================

# =============================================================================
# BACKEND (FastAPI) — consumed by backend/app/core/config.py (pydantic-settings)
# Copy this section into backend/.env
# =============================================================================

# deployment | staging | production — controls error verbosity and headers
ENVIRONMENT=development

# true enables debug responses/logging; MUST be false in production
DEBUG=true

# structlog level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Async SQLAlchemy URL. Driver MUST be asyncpg.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Local Docker default host is localhost:5432 (container mahindra-postgres).
# Current cutover state on the source machine: points at mahindra_ai_staging.
DATABASE_URL=postgresql+asyncpg://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5432/mahindra_ai

# asyncpg connection-pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Echo every SQL statement (dev debugging only; very noisy)
DB_ECHO=false

# Comma-separated browser origins allowed by CORS middleware.
# Must include the frontend origin (dev server runs on 8080 here).
CORS_ORIGINS=http://localhost:8080

# AI layer provider:
#   rule   — deterministic, in-repository logic (no external calls, default)
#   openai — routes copilot/explain features through the OpenAI API
AI_PROVIDER=rule

# Required ONLY when AI_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=

# =============================================================================
# FRONTEND (Vite / TanStack Start) — consumed via import.meta.env.VITE_*
# Copy this section into frontend/.env.local
# =============================================================================

# Base URL of the FastAPI backend. All API calls are mounted under /api/v1.
# The frontend is API-only: without a reachable backend, screens fall back
# to SSR defaults / empty states.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# =============================================================================
# DOCKER COMPOSE (backend/docker-compose.yml) — already defined in the file.
# Listed here for completeness; change ONLY via the compose file or shell env.
# =============================================================================

# POSTGRES_USER=CHANGE_ME_USER
# POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
# POSTGRES_DB=mahindra_ai
# (the API service additionally receives DATABASE_URL, ENVIRONMENT, DEBUG,
#  LOG_LEVEL, CORS_ORIGINS, AI_PROVIDER — see backend/docker-compose.yml)

# ----------------------------------------------------------------------
# Causal synthetic replay / scheduler
# ----------------------------------------------------------------------
SIMULATION_MINUTES_PER_REAL_MINUTE=60
SIMULATION_TICK_INTERVAL_SECONDS=60
CAUSAL_SCHEDULER_ENABLED=true
CAUSAL_SCHEDULER_POLL_SECONDS=10
MANUFACTURING_CAUSAL_REFRESH_MINUTES=60
TELEMATICS_CAUSAL_REFRESH_MINUTES=30
