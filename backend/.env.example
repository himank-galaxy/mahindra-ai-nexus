# Mahindra AI Command Center backend — environment template.
# Copy to .env and adjust per environment. Never commit real .env files.

# ----------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------
ENVIRONMENT=development            # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ----------------------------------------------------------------------
# Database (one local SQLite file containing mock + synthetic data)
# ----------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///database/mahindra_ai.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ----------------------------------------------------------------------
# CORS — comma-separated origins of the frontend
# ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ----------------------------------------------------------------------
# AI layer
# ----------------------------------------------------------------------
AI_PROVIDER=rule                   # rule | openai
OPENAI_API_KEY=                    # required only when AI_PROVIDER=openai
OPENAI_BASE_URL=                   # required only when AI_PROVIDER=openai
OPENAI_MODEL=                      # required only when AI_PROVIDER=openai

# ----------------------------------------------------------------------
# Auto Mobility Causal Twin — PCMCI over live mobility_timeseries.
# No replay clock/scheduler for this one; see
# docs/Implementation_plan_mobility_causal.md.
# ----------------------------------------------------------------------
MOBILITY_CAUSAL_WINDOW_DAYS=90
MOBILITY_CAUSAL_SAMPLE_STRIDE_HOURS=12
MOBILITY_CAUSAL_MIN_OBSERVATIONS=50
MOBILITY_CAUSAL_TAU_MAX=2
MOBILITY_CAUSAL_PC_ALPHA=0.30
MOBILITY_CAUSAL_REFRESH_MINUTES=60

# ----------------------------------------------------------------------
# Causal synthetic replay / scheduler
# ----------------------------------------------------------------------
SIMULATION_MINUTES_PER_REAL_MINUTE=60
SIMULATION_TICK_INTERVAL_SECONDS=60
CAUSAL_SCHEDULER_ENABLED=true
CAUSAL_SCHEDULER_POLL_SECONDS=10
MANUFACTURING_CAUSAL_REFRESH_MINUTES=60
TELEMATICS_CAUSAL_REFRESH_MINUTES=30
