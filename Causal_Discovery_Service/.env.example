# Causal Discovery Service - configuration reference
#
# None of these need to be set - every one has a working default (see
# config.py and IMPLEMENTATION_PLAN.md section 9). Copy this file to .env
# and uncomment/edit only the values you want to change.
#
# This service reads the database read-only. It uses the same connection
# resolution convention as the rest of this project (MAHINDRA_DATABASE_URL,
# then DATABASE_URL, then a local default) - but the code that reads these
# is defined independently in this service's own config.py, not imported
# from anywhere else.

# --- Database connection (read-only) ---
# MAHINDRA_DATABASE_URL=postgresql://mahindra:mahindra@127.0.0.1:5432/mahindra_ai
# DATABASE_URL=postgresql://mahindra:mahindra@127.0.0.1:5432/mahindra_ai

# --- Manufacturing domain ---
# CDS_MANUFACTURING_TAU_MIN=0
# CDS_MANUFACTURING_TAU_MAX=6
# CDS_MANUFACTURING_PC_ALPHA=0.05
# CDS_MANUFACTURING_WINDOW_HOURS=24
# CDS_MANUFACTURING_RESAMPLE_MINUTES=5
# CDS_MANUFACTURING_MIN_RAW_ROWS=300
# CDS_MANUFACTURING_MAX_ENTITIES=15
# CDS_MANUFACTURING_MAX_GAP_BINS=3
# CDS_MANUFACTURING_NEAR_CONSTANT_STD=0.000001
# CDS_MANUFACTURING_STATIONARITY_PVALUE=0.05
# CDS_MANUFACTURING_AUTO_DIFFERENCE=false

# --- Telematics domain ---
# CDS_TELEMATICS_TAU_MIN=0
# CDS_TELEMATICS_TAU_MAX=4
# CDS_TELEMATICS_PC_ALPHA=0.05
# CDS_TELEMATICS_WINDOW_HOURS=168
# CDS_TELEMATICS_RESAMPLE_MINUTES=15
# CDS_TELEMATICS_MIN_RAW_ROWS=100
# CDS_TELEMATICS_MAX_ENTITIES=15
# CDS_TELEMATICS_MAX_GAP_BINS=3
# CDS_TELEMATICS_NEAR_CONSTANT_STD=0.000001
# CDS_TELEMATICS_STATIONARITY_PVALUE=0.05
# CDS_TELEMATICS_AUTO_DIFFERENCE=false
